{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "eslint src tests",
    "format": "prettier --write src tests *.js *.ts *.json",
    "format:check": "prettier --check src tests *.js *.ts *.json",
    "postinstall": "node scripts/after-install.cjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.0.17",
    "@types/react-dom": "^18.0.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "10.14.0",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
